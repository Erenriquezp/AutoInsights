# Copy to .env and adjust. Every value has a working default in docker-compose.yml,
# so .env is optional for local development.

# API
# Gold tables written by the ETL (<GOLD_PATH>/<table>/*.parquet). Default: backend/data/gold
GOLD_PATH=/app/data/gold
# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# "Ask the data" (free tiers). Without keys the offline demo provider answers the examples.
LLM_PROVIDER=fallback        # fallback (Groq, then Gemini) | groq | gemini | fake
GROQ_API_KEY=                # https://console.groq.com/keys
GEMINI_API_KEY=              # https://aistudio.google.com/apikey
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.5-flash-lite
# ASK_PER_MINUTE=6           # questions per visitor per minute
# ASK_PER_DAY=500            # questions per day, all visitors

# Frontend (read at build time by Vite)
VITE_API_URL=http://localhost:8000/api
